//0RDERING A FOOD USING ASYNC AND AWAIT
function orderfood()
{
    return new Promise((resolve, reject) => {
         setTimeout(()=>{
        console.log("order is placed");
        resolve()
        
    },2000)
   
        
});
}
function preparefood()
{
    return new Promise((resolve, reject) => {
    setTimeout(()=>{
        console.log("food is prepared");
        resolve()
        
},4000)
});
}
function payment()
{
     return new Promise((resolve, reject) => {
    setTimeout(()=>{
        console.log("Payment Succesfull");
        resolve()
        
        
    },2000)
});
}
function takeAway()
{
    return new Promise((resolve, reject) => {
    setTimeout(()=>{
        console.log("Your order is ready to take");
        resolve()
        
        
},3000)
});
}
async function processOrder() {
  try {
    await orderfood();
    await preparefood();
    await payment();
    await takeAway();
    console.log("enjoy ur meal");
  } catch (error) {
    console.error("Order failed:", error);
  }
}

processOrder();




